:root{--ink:#090806;--panel:#171511;--panel2:#242019;--gold:#bd9550;--gold2:#e6ca8e;--bone:#f1e6cf;--muted:#aa9d87;--red:#8e4239;--green:#71875d;--blue:#315f91;--line:rgba(241,230,207,.15);--line2:rgba(230,202,142,.34);--shadow:0 22px 60px rgba(0,0,0,.48)}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:#080706;color:var(--bone);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,sans-serif}body{overflow:hidden}button,input,select{font:inherit;color:inherit}button{cursor:pointer}h1,h2,h3{font-family:Georgia,"Times New Roman",serif;font-weight:500}h1{font-size:clamp(42px,7vw,72px);line-height:.98;margin:.12em 0}h2{font-size:clamp(27px,4vw,42px);margin:.12em 0}.eyebrow{font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold2);font-weight:800}.sub{color:var(--muted);line-height:1.5}.hidden{display:none!important}.screen{position:fixed;inset:0;display:none;background:radial-gradient(circle at 50% -10%,rgba(189,149,80,.11),transparent 38%),linear-gradient(#11100d,#080706 76%);overflow:hidden}.screen.active{display:block}.scroll{height:100%;overflow:auto;-webkit-overflow-scrolling:touch;padding:max(18px,env(safe-area-inset-top)) max(18px,env(safe-area-inset-right)) max(18px,env(safe-area-inset-bottom)) max(18px,env(safe-area-inset-left))}.page{width:min(1120px,100%);margin:auto}.panel{background:linear-gradient(180deg,rgba(31,29,24,.97),rgba(17,16,13,.98));border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow)}.btn{display:flex;align-items:center;justify-content:center;gap:9px;padding:13px 15px;border:1px solid rgba(226,201,141,.28);border-radius:11px;background:linear-gradient(#39342a,#201d18);font-weight:750}.btn.primary{background:linear-gradient(#765c31,#43351f);border-color:#a58349}.btn.danger{background:linear-gradient(#743b34,#45221e);border-color:#945148}.btn.ghost{background:rgba(10,9,7,.30)}.btn:disabled{opacity:.35;cursor:default}.iconbtn{width:42px;height:42px;padding:0}.topbar{display:flex;align-items:center;gap:12px;margin-bottom:17px}.topbar .spacer{flex:1}.badge{display:inline-flex;align-items:center;padding:6px 9px;border-radius:999px;border:1px solid rgba(124,146,95,.38);color:#cbd8b5;background:rgba(124,146,95,.08);font-size:9px;letter-spacing:.1em}.badge.assisted{border-color:rgba(184,130,85,.5);color:#e0b58c;background:rgba(184,130,85,.10)}.badge.modified,.badge.sandbox{border-color:rgba(142,66,57,.5);color:#e0aaa4;background:rgba(142,66,57,.12)}.hero{height:100%;display:grid;place-items:center;padding:18px}.hero-card{width:min(760px,100%);padding:32px;text-align:center;position:relative;overflow:hidden}.hero-card:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(10,9,7,.54),rgba(10,9,7,.94)),url('https://raw.githubusercontent.com/asundr/gwent-classic/main/img/board.jpg');background-size:cover;background-position:center;opacity:.88}.hero-card>*{position:relative}.seal{width:84px;height:84px;border-radius:50%;display:grid;place-items:center;margin:0 auto 15px;border:1px solid var(--line2);background:radial-gradient(circle,#3d3427,#17140f 72%);font:700 30px Georgia;color:var(--gold2);box-shadow:0 0 48px rgba(189,149,80,.16)}.menu{display:grid;gap:9px;max-width:430px;margin:26px auto 0}.menu .btn{justify-content:space-between}.menu strong{font:700 17px Georgia}.buildline{margin-top:18px;font-size:10px;color:#827763;letter-spacing:.08em}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:13px}.play-subgrid{margin-top:13px}.mode-card{padding:18px;min-height:190px;display:flex;flex-direction:column}.mode-card.compact{min-height:0}.mode-card h3{font-size:25px}.mode-card .btn{margin-top:auto}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.stat{padding:12px;border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.015)}.stat b{display:block;font-size:21px;color:var(--gold2)}.catalog-list{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:12px}.catalog-row{padding:11px;border:1px solid var(--line);border-radius:10px;background:#15130f}.catalog-row b{display:block}.catalog-row small{color:var(--muted)}.search{width:100%;padding:12px;border-radius:10px;border:1px solid var(--line);background:#0f0e0b;color:var(--bone);outline:none}.deck-list{display:grid;gap:9px}.deck-card{display:flex;align-items:center;gap:10px;padding:11px;border:1px solid rgba(241,230,207,.08);border-radius:12px;background:#15120f}.deck-page-panel,.status-panel{padding:16px}.mini-art{width:44px;height:63px;object-fit:cover;border-radius:5px;border:1px solid var(--line2);background:#2b251c}.deck-card .qty{margin-left:auto;color:var(--gold2)}.setup-stack{display:grid;gap:14px}.setup-panel{padding:16px}.selector-group{display:grid;gap:9px}.selector-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.option-row{display:flex;flex-wrap:wrap;gap:8px}.option-chip{padding:10px 12px;border-radius:11px;border:1px solid rgba(226,201,141,.24);background:#15120f;color:#d6c7ac;min-width:120px;text-align:left}.option-chip.active{background:linear-gradient(#6d5732,#3e3120);border-color:#b48a4e;color:#fff2da;box-shadow:0 0 0 1px rgba(226,201,141,.16) inset}.option-chip small{display:block;color:#aa9d87;margin-top:2px}.setup-summary{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}.setup-kv{padding:12px;border:1px solid var(--line);border-radius:12px;background:#14110e}.setup-kv b{display:block;color:var(--gold2);font-size:12px;margin-bottom:3px}.seed-input,.mini-select{padding:10px 11px;border-radius:10px;border:1px solid var(--line);background:#0f0e0b;color:var(--bone);outline:none;min-width:0}.setup-actions{display:flex;flex-wrap:wrap;gap:10px;justify-content:flex-end;margin-top:8px}.mulligan-brief,.mulligan-footer{padding:14px;margin-bottom:12px}.mulligan-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mulligan-card{padding:10px;border-radius:14px;border:1px solid var(--line);background:linear-gradient(#1d1a15,#12100d);display:grid;grid-template-columns:64px 1fr;gap:10px;align-items:center}.mulligan-card img{width:64px;height:92px;object-fit:cover;border-radius:8px;border:1px solid var(--line2);background:#2b251c}.mulligan-card h4{margin:0 0 4px 0;font-size:16px}.mulligan-card p{margin:0;font-size:12px;color:var(--muted)}.mulligan-card .btn{margin-top:8px;font-size:10px;padding:8px 10px}.mulligan-meta{font-size:12px;color:var(--muted)}.inline-actions{display:flex;flex-wrap:wrap;gap:10px;justify-content:flex-end}#match-screen{padding:0;background:#080604}.battle-shell{position:absolute;inset:0;display:grid;grid-template-rows:auto 1fr auto;overflow:hidden;background-image:linear-gradient(rgba(6,4,3,.22),rgba(6,4,3,.28)),url('https://raw.githubusercontent.com/asundr/gwent-classic/main/img/board.jpg');background-size:cover;background-position:center}.battle-shell:after{content:"";position:absolute;inset:0;pointer-events:none;z-index:1;box-shadow:inset 0 0 80px 18px rgba(0,0,0,.48)}.battle-top{z-index:6;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;padding:calc(5px + env(safe-area-inset-top)) calc(8px + env(safe-area-inset-right)) 5px calc(8px + env(safe-area-inset-left));background:linear-gradient(rgba(7,6,5,.92),rgba(7,6,5,.45));border-bottom:1px solid rgba(238,228,206,.10)}.matchline{display:flex;justify-content:center;align-items:center;gap:8px;min-width:0;font-size:9px;letter-spacing:.07em;text-shadow:0 2px 4px #000}.total{font:700 22px Georgia;color:var(--gold2)}.faction-dot{width:25px;height:25px;border-radius:50%;display:grid;place-items:center;font-size:7px;font-weight:900;border:1px solid rgba(255,255,255,.25)}.faction-dot.monsters{background:#54251f}.faction-dot.realms{background:#204f85}.turn-actions{display:flex;gap:5px}.battle-icon{width:40px;height:40px;border-radius:10px;border:1px solid rgba(226,201,141,.26);background:linear-gradient(#39342a,#201d18);display:grid;place-items:center;padding:0}.bot-button{font-size:8px;padding:7px 8px;border-radius:9px;border:1px solid rgba(226,201,141,.35);background:#40351f;white-space:nowrap}.board-ui{z-index:2;min-height:0;display:grid;grid-template-rows:repeat(3,minmax(0,1fr)) 20px repeat(3,minmax(0,1fr));gap:4px;padding:6px max(18px,env(safe-area-inset-right)) 4px max(18px,env(safe-area-inset-left));margin:0 auto;width:min(100%,852px)}.lane{min-height:0;display:grid;grid-template-columns:44px 28px 1fr 35px;align-items:center;overflow:hidden;position:relative;border-radius:8px;background:linear-gradient(90deg,rgba(10,8,6,.22),rgba(26,15,10,.08),rgba(10,8,6,.18));border:1px solid rgba(238,228,206,.06)}.lane.weathered{background:linear-gradient(90deg,rgba(72,92,112,.34),rgba(32,43,53,.10),rgba(72,92,112,.26));box-shadow:inset 0 0 22px rgba(110,145,174,.12)}.rlabel{display:grid;place-items:center;font-size:7px;letter-spacing:.18em;color:#d7c8aa}.special-slot{width:20px;height:20px;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(204,160,104,.42);background:rgba(18,13,9,.45);margin:0 auto}.special-slot.active{background:radial-gradient(circle,#6d4c24,#281a10 76%);box-shadow:0 0 0 1px rgba(215,174,113,.15) inset,0 0 10px rgba(231,193,128,.18)}.special-slot img{width:100%;height:100%;border-radius:50%;object-fit:cover}.special-slot span{font-size:7px;font-weight:800;color:#f0d39d}.units{display:flex;align-items:center;padding:2px 4px;overflow:hidden}.unit{height:86%;aspect-ratio:.696;max-width:55px;min-width:34px;margin-right:-6px;border-radius:5px;border:1px solid rgba(226,201,141,.34);background:#2a241c;box-shadow:0 6px 13px rgba(0,0,0,.36);position:relative;overflow:hidden}.unit img{width:100%;height:100%;object-fit:cover;display:block}.u-score{position:absolute;left:2px;top:2px;width:18px;height:18px;border-radius:50%;display:grid;place-items:center;background:rgba(239,229,204,.96);color:#111;font:700 10px Georgia}.modified-power{box-shadow:0 0 0 1px rgba(0,0,0,.2)}.u-mark{position:absolute;right:3px;bottom:2px;color:#f1cf70;text-shadow:0 1px 2px #000;font-size:10px}.rscore{display:grid;place-items:center;font:700 17px Georgia;color:var(--gold2)}.weather{display:flex;justify-content:center;align-items:center;gap:10px;padding:0 8px;font-size:8px;letter-spacing:.10em;color:#c9bda7}.weather.active{color:#d8e8f5;background:rgba(70,100,124,.15);border-radius:999px}.weather-cards{display:flex;gap:4px;align-items:center}.weather-pill{height:16px;padding:0 7px;border-radius:999px;background:rgba(16,13,11,.86);border:1px solid rgba(178,142,96,.35);display:flex;align-items:center;gap:4px}.weather-pill img{width:11px;height:16px;border-radius:2px;object-fit:cover}.battle-bottom{z-index:6;display:grid;grid-template-columns:auto 1fr auto;align-items:end;gap:8px;padding:4px calc(8px + env(safe-area-inset-right)) calc(7px + env(safe-area-inset-bottom)) calc(8px + env(safe-area-inset-left));background:linear-gradient(rgba(8,7,6,.25),rgba(8,7,6,.82));border-top:1px solid rgba(238,228,206,.08)}.counts{display:flex;gap:8px;font-size:9px;color:#b7aa93;padding-bottom:9px;white-space:nowrap}.hand{display:flex;justify-content:center;align-items:end;height:70px;min-width:0}.hand-card{width:49px;height:68px;margin:0 -5px;border-radius:6px;border:1px solid rgba(226,201,141,.36);position:relative;box-shadow:0 6px 12px rgba(0,0,0,.38);overflow