:hidden;background:#2b251c;padding:0}.hand-card img{width:100%;height:100%;object-fit:cover}.hand-card:hover,.hand-card:focus{transform:translateY(-5px);z-index:3}.hc-name{position:absolute;left:3px;right:3px;bottom:3px;font:700 6.5px Georgia;text-shadow:0 1px 2px #000;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.player-meta{display:flex;align-items:center;gap:6px;padding-bottom:1px}.passbtn{min-width:78px;padding:10px 11px;border-radius:9px;font-weight:800;background:linear-gradient(#743b34,#45221e);border:1px solid #945148}.leader-mini{position:absolute;z-index:5;left:max(26px,env(safe-area-inset-left));bottom:86px;width:44px;height:63px;border-radius:6px;border:1px solid rgba(226,201,141,.35);overflow:hidden;box-shadow:0 6px 15px rgba(0,0,0,.4);background:transparent;padding:0;cursor:pointer}.leader-mini img{width:100%;height:100%;object-fit:cover}.leader-mini.available{outline:1px solid rgba(166,207,107,.75);box-shadow:0 0 0 2px rgba(145,173,107,.14),0 6px 15px rgba(0,0,0,.4)}.leader-mini.spent{filter:saturate(.35) brightness(.62)}.leader-mini:disabled{cursor:default}.leader-status{position:absolute;left:50%;bottom:-15px;transform:translateX(-50%);font-size:6px;letter-spacing:.08em;color:#d7cbaf;background:rgba(10,9,7,.9);padding:2px 4px;border-radius:5px;white-space:nowrap}.leader-mini.available .leader-status{color:#bada96}.state-toast{position:absolute;z-index:8;left:50%;top:48px;transform:translateX(-50%);padding:5px 9px;border:1px solid rgba(226,201,141,.28);border-radius:999px;background:rgba(13,11,9,.91);font-size:8px;letter-spacing:.08em;opacity:0;transition:.2s;pointer-events:none;white-space:nowrap}.state-toast.show{opacity:1;top:52px}.shade{position:absolute;inset:0;z-index:20;background:rgba(4,4,3,.62);backdrop-filter:blur(2px)}.side-panel{position:absolute;z-index:30;right:0;top:0;bottom:0;width:min(455px,56vw);padding:max(13px,env(safe-area-inset-top)) max(14px,env(safe-area-inset-right)) max(13px,env(safe-area-inset-bottom)) 14px;background:linear-gradient(#1b1915,#0f0e0c);border-left:1px solid rgba(226,201,141,.34);box-shadow:-20px 0 55px rgba(0,0,0,.55);overflow:auto}.panel-x{position:absolute;right:12px;top:max(10px,env(safe-area-inset-top));width:35px;height:35px;border-radius:50%;display:grid;place-items:center;background:#29251e;border:1px solid var(--line);font-size:20px;padding:0}.inspector-grid{display:grid;grid-template-columns:145px 1fr;gap:14px;margin-top:28px}.inspect-art{width:145px;aspect-ratio:.696;object-fit:cover;border-radius:10px;border:1px solid var(--line2);box-shadow:0 16px 35px rgba(0,0,0,.45)}.inspect-copy h2{font-size:24px}.inspect-copy p{font-size:10px;line-height:1.45;color:#c3b59d}.actions{display:grid;gap:7px;margin-top:12px}.actions .btn{font-size:10px;padding:10px}.choice-list{display:grid;gap:7px;margin-top:10px}.choice-card{display:flex;align-items:center;gap:9px;padding:8px;border:1px solid var(--line);border-radius:9px;background:#191611}.choice-card img{width:38px;height:55px;object-fit:cover;border-radius:4px}.choice-card .btn{margin-left:auto;font-size:9px;padding:8px}.cheat-row{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid rgba(238,228,206,.08)}.cheat-row b{font-size:12px}.cheat-row small{display:block;color:#9f927d;font-size:8px;margin-top:2px}.cheat-row .btn{font-size:9px;padding:7px 9px}.drawer-section{font-size:9px;letter-spacing:.18em;color:var(--gold2);font-weight:900;margin-top:14px;padding-bottom:6px}.opp-hand-reveal{position:absolute;z-index:9;top:50px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:5px;padding:5px 7px;border-radius:9px;background:rgba(17,15,12,.95);border:1px solid rgba(184,130,85,.42)}.opp-hand-reveal .unit{height:43px;min-width:30px}.ai-intent{position:absolute;z-index:9;right:max(56px,env(safe-area-inset-right));top:51px;width:220px;padding:9px;border-radius:10px;background:rgba(17,15,12,.95);border:1px solid rgba(184,130,85,.42);display: